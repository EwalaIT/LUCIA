# .env.example - copy to .env and fill values

# Database
DB_PATH=./db/agent_memory.db

# LangSmith (observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name_here
LANGSMITH_OUTPUT_DIR=./langsmith_logs

# Ollama (or other LLM host)
# If you use an Ollama local server: e.g. http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ollama-model

# Home Assistant
HA_URL=http://localhost:8123
HA_TOKEN=large_access_token

# Optional general
ENV=development
LOG_LEVEL=INFO
