# ==================================================
# LUCIA – Global Configuration
# ==================================================

# ------------------
# Database (SQLite)
# ------------------
DB_PATH=/data/db/lucia.db

# ------------------
# Ollama (External)
# ------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=aliafshar/gemma3-it-qat-tools:12b

# ------------------
# Home Assistant (External)
# ------------------
HA_URL=http://homeassistant.local:8123
HA_TOKEN=__USER_PROVIDED__

# ------------------
# Setup Wizard
# ------------------
VITE_SETUP_WIZARD_API_BASE_URL=http://setup-wizard-backend:8080/api

# ------------------
# LangChain Services
# ------------------
LANGCHAIN_API_PORT=8000
LANGCHAIN_MCP_PORT=8001
LANGCHAIN_BACKEND_URL=http://langchain-backend:8000
LANGCHAIN_MCP_URL=http://langchain-mcp:8001

# ------------------
# Environment
# ------------------
ENV=production
LOG_LEVEL=INFO
